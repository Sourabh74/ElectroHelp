# Copy this file to .env for local development.
# For hosted deployments, set these values in the platform's environment settings.
# Recommended for Render: copy the PostgreSQL connection string from your
# provider's dashboard. For Supabase, use Connect -> Session pooler.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/electrician

# The DB_* settings are an alternative to DATABASE_URL.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=electrician
# DB_USER=postgres
# DB_PASSWORD=YOUR_PASSWORD

DB_SCHEMA=electrician
DB_SSL=false
# For hosted databases with a custom CA, set DB_SSL_CA to the downloaded PEM certificate.
# Alternatively, set DB_SSL_CA_FILE to the PEM file's path (for example, a Render secret file).
NODE_ENV=development

# Email OTP verification and password reset (SMTP).
# Generate EMAIL_OTP_SECRET with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
EMAIL_OTP_SECRET=replace-with-a-random-secret-at-least-32-characters-long
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_SECURE=true for implicit TLS (usually port 465); false for STARTTLS (usually port 587).
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=ElectroHelp <no-reply@example.com>
